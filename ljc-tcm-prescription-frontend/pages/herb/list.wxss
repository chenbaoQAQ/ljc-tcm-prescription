/* pages/herb/list.wxss */
.add-herb-row {
  display: flex;
  gap: 15rpx;
  align-items: center;
}

.add-herb-row .form-input {
  flex: 1;
}

.add-btn {
  width: 150rpx;
  font-size: 32rpx;
  padding: 20rpx;
}

.section-title {
 font-size: 32rpx;
  font-weight: bold;
  margin: 30rpx 0 20rpx;
}

.herb-list {
  min-height: 400rpx;
}

.herb-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  padding: 30rpx;
  margin-bottom: 15rpx;
  border-radius: 12rpx;
}

.herb-name {
  font-size: 32rpx;
  flex: 1;
}

.delete-btn {
  background: #ff4d4f;
  color: white;
  padding: 8rpx 20rpx;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 150rpx 0;
  color: #999;
  font-size: 32rpx;
}