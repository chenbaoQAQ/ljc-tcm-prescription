<view class="container">
  <view class="header">
    <text class="title">Select Prescriptions to Merge</text>
  </view>

  <!-- Search -->
  <view class="search-bar">
    <input class="search-input" placeholder="Search prescriptions..." bindinput="onSearchInput" value="{{keyword}}" />
  </view>

  <!-- Prescription List with Checkboxes -->
  <scroll-view scroll-y class="list-container">
    <block wx:if="{{prescriptions.length > 0}}">
      <view class="prescription-item" wx:for="{{prescriptions}}" wx:key="id" data-id="{{item.id}}" bindtap="onToggleSelect">
        <checkbox-group>
          <label>
            <checkbox value="{{item.id}}" checked="{{item.selected}}" />
            <view class="prescription-info">
              <text class="prescription-name">{{item.name}}</text>
              <text class="prescription-detail">{{item.herbCount || 0}} herbs</text>
            </view>
          </label>
        </checkbox-group>
      </view>
    </block>
    <view wx:else class="empty-state">No prescriptions available.</view>
  </scroll-view>

  <!-- Generate Button -->
  <view class="action-bar">
    <text class="selected-count">Selected: {{selectedCount}}</text>
    <button type="primary" bindtap="onMerge">Generate Merged List</button>
  </view>
</view>