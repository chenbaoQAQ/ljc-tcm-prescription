/* pages/merge/index.wxss */
.header {
  text-align: center;
  padding: 30rpx 20rpx;
  background: white;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.search-bar {
  padding: 20rpx;
  background: white;
  margin-bottom: 10rpx;
}

.search-input {
  width: 100%;
  background: #f5f5f5;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.list-container {
  height: calc(100vh - 300rpx);
  padding-bottom: 20rpx;
}

.prescription-item {
  background: white;
  padding: 20rpx;
  margin: 10rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.prescription-item checkbox-group label {
  display: flex;
  align-items: center;
  width: 100%;
}

.prescription-info {
  margin-left: 20rpx;
  flex: 1;
}

.prescription-name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 5rpx;
}

.prescription-detail {
  display: block;
  font-size: 26rpx;
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.selected-count {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}