/* pages/merge/result.wxss */
.header {
  text-align: center;
  padding: 30rpx 20rpx;
  background: white;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.herb-list {
  height: calc(100vh - 280rpx);
  padding: 0 20rpx;
}

.herb-card {
  background: white;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.herb-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.herb-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.herb-dose {
  font-size: 36rpx;
  font-weight: bold;
  color: #07c160;
}

.herb-sources {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #f0f0f0;
}

.sources-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.source-item {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-left: 10rpx;
  margin-bottom: 3rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  gap: 20rpx;
}

.action-bar button {
  flex: 1;
}