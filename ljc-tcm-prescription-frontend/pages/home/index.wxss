/* pages/home/index.wxss */
.header {
  text-align: center;
  margin: 60rpx 0;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.menu-list {
  margin-top: 40rpx;
}

.menu-item {
  background: white;
  padding: 40rpx;
  margin-bottom: 30rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.menu-item.highlight {
  background: #eaffee;
  border: 1rpx solid #07c160;
  color: #07c160;
}

.arrow {
  color: #ccc;
}