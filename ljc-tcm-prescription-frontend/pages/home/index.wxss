/* pages/home/index.wxss */
.header {
  text-align: center;
  padding: 80rpx 0 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

.menu-list {
  padding: 40rpx 30rpx;
}

.menu-btn {
  width: 100%;
  height: 160rpx;
  background: white;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: none;
  font-size: 36rpx;
}

.menu-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.menu-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 36rpx;
  font-weight: 500;
}

.menu-btn.primary .menu-text {
  color: white;
}