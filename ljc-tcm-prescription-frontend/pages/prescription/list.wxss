/* pages/prescription/list.wxss */
.top-bar {
  padding: 20rpx;
  background: white;
  margin-bottom: 20rpx;
}

.add-btn {
  width: 100%;
  font-size: 34rpx;
  padding: 25rpx;
}

.prescription-list {
  padding: 0 20rpx;
}

.prescription-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  padding: 30rpx;
  margin-bottom: 15rpx;
  border-radius: 12rpx;
}

.prescription-name {
  font-size: 32rpx;
  font-weight: 500;
  flex: 1;
}

.actions {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  font-size: 28rpx;
}

.action-btn.edit {
  background: #1890ff;
  color: white;
}

.action-btn.delete {
  background: #ff4d4f;
  color: white;
}

.empty-state {
  text-align: center;
  padding: 150rpx 0;
  color: #999;
  font-size: 32rpx;
}