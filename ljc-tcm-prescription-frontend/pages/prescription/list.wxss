/* pages/prescription/list.wxss */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input {
  flex: 1;
  background: #f0f0f0;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  margin-right: 20rpx;
}

.search-btn {
  color: #07c160;
  font-weight: 500;
}

.list-container {
  padding-bottom: 100rpx;
}

.card {
  background: white;
  margin: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.card-header {
  margin-bottom: 15rpx;
}

.prescription-name {
  font-size: 34rpx;
  font-weight: bold;
}

.card-body {
  color: #666;
  margin-bottom: 20rpx;
}

.info-text {
  font-size: 26rpx;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.fab {
  position: fixed;
  bottom: 60rpx;
  right: 60rpx;
  width: 100rpx;
  height: 100rpx;
  background: #07c160;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.4);
  z-index: 20;
}

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}