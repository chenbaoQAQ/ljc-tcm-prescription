/* pages/prescription/edit.wxss */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  margin: 30rpx 0 20rpx;
}

.add-item-btn {
  padding: 8rpx 20rpx;
  font-size: 28rpx;
}

.items-list {
  min-height: 400rpx;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 15rpx;
  background: white;
  padding: 20rpx;
  margin-bottom: 15rpx;
  border-radius: 12rpx;
}

.herb-picker {
  flex: 1;
  min-width: 0;
}

.picker-display {
  padding: 15rpx 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dose-input {
  width: 140rpx;
  padding: 15rpx 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  text-align: right;
  font-size: 30rpx;
}

.unit {
  font-size: 28rpx;
  color: #666;
  width: 30rpx;
}

.delete-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0;
  background: #ff4d4f;
  color: white;
  font-size: 40rpx;
  border-radius: 50%;
}

.empty-hint {
 text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}

.save-btn {
  width: 100%;
  font-size: 36rpx;
  padding: 30rpx;
  margin-top: 40rpx;
}