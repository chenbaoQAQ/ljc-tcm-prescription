<view class="container">
  <!-- 基本信息 -->
  <view class="card">
    <view class="form-item">
      <view class="form-label">患者姓名 *</view>
      <input class="form-input" placeholder="请输入患者姓名" value="{{patientName}}" bindinput="onPatientNameInput" />
    </view>

    <view class="form-item">
      <view class="form-label">就诊日期</view>
      <picker mode="date" value="{{visitDate}}" bindchange="onDateChange">
        <view class="picker-display">{{visitDate}}</view>
      </picker>
    </view>
  </view>

  <!-- 选择药方 -->
  <view class="section-title">
    <text>选择药方（至少1个）</text>
    <input class="search-input" placeholder="搜索药方..." value="{{searchKeyword}}" bindinput="onSearchInput" />
  </view>

  <view class="prescription-list">
    <checkbox-group bindchange="onPrescriptionChange">
      <label class="prescription-item" wx:for="{{prescriptions}}" wx:key="id">
        <checkbox value="{{item.id}}" checked="{{item.checked}}" />
        <text class="prescription-name">{{item.name}}</text>
      </label>
    </checkbox-group>
    
    <view wx:if="{{prescriptions.length === 0}}" class="empty-hint">
      暂无药方，请先去"制作药方"
    </view>
  </view>

  <!-- 预览提示 -->
  <view class="preview-hint">
    已选 {{selectedCount}} 个药方，保存后自动生成总药材清单
  </view>

  <!-- 保存按钮 -->
  <button class="save-btn" type="primary" bindtap="onSave">保存病历</button>
</view>

<!-- 成功弹窗 -->
<view class="modal-mask" wx:if="{{showSuccessModal}}" catchtap="onMaskTap">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-title">✅ 病历保存成功</view>
    
    <view class="result-section">
      <view class="result-label">药方：</view>
      <view class="result-text">{{savedResult.prescriptionNames}}</view>
    </view>

    <view class="result-section">
      <view class="result-label">所需药材：</view>
      <view class="result-text herbs">{{savedResult.mergedHerbsText}}</view>
      <button class="copy-btn" size="mini" bindtap="onCopyHerbs">复制药材清单</button>
    </view>

    <view class="modal-buttons">
      <button class="modal-btn" bindtap="onContinue">继续开一个</button>
      <button class="modal-btn primary" bindtap="onGoToHistory">去看历史</button>
    </view>
  </view>
</view>
