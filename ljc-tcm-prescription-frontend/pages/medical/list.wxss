/* pages/medical/list.wxss */
.container {
  background-color: #f7f7f7;
  min-height: 100vh;
}

.search-bar {
  display: flex;
  padding: 20rpx;
  gap: 15rpx;
  background: white;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  background: #f5f5f5;
  padding: 18rpx 25rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  height: 70rpx;
  line-height: 70rpx;
}

.search-btn {
  padding: 0 40rpx;
  font-size: 30rpx;
  height: 70rpx;
  line-height: 70rpx;
  display: flex;
  align-items: center;
}

.record-list {
  padding: 0 20rpx 40rpx;
}

.record-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.header-left {
  display: flex;
  align-items: center;
}

.visit-badge {
  background: #1890ff;
  color: white;
  font-size: 24rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 15rpx;
}

.patient-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.visit-date {
  font-size: 26rpx;
  color: #999;
}

.record-body {
  font-size: 28rpx;
}

.info-row {
  margin-bottom: 15rpx;
  display: flex;
}

.info-row.herbs {
  flex-direction: column;
}

.label {
  color: #666;
  margin-right: 10rpx;
  flex-shrink: 0;
  min-width: 80rpx;
}

.value {
  color: #333;
  line-height: 1.6;
  flex: 1;
}

.notes-text {
  color: #666;
  font-style: italic;
}

.info-row.herbs .value {
  margin-top: 10rpx;
  background: #f9f9f9;
  padding: 15rpx;
  border-radius: 8rpx;
  color: #555;
  font-size: 26rpx;
  word-break: break-all;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 15rpx;
  border-top: 1rpx dashed #eee;
}

.delete-btn {
  margin: 0 !important;
  font-size: 24rpx !important;
}

.empty-state {
  text-align: center;
  padding: 150rpx 0;
  color: #999;
  font-size: 30rpx;
}

/* 详情弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  max-height: 80vh;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  overflow-y: auto;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.detail-item {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  display: flex;
}

.detail-item.full {
  flex-direction: column;
}

.detail-label {
  color: #666;
  margin-right: 15rpx;
  min-width: 90rpx;
}

.herbs-text {
  display: block;
  margin-top: 10rpx;
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 8rpx;
  line-height: 1.6;
  word-break: break-all;
  color: #333;
  font-size: 28rpx;
}

.copy-btn {
  width: 100% !important;
  margin-top: 30rpx !important;
  font-size: 30rpx !important;
}

.close-btn {
  width: 100% !important;
  margin-top: 20rpx !important;
  font-size: 30rpx !important;
  background: #f5f5f5;
  color: #666;
}
