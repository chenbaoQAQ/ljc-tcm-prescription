/* pages/medical/list.wxss */
.search-bar {
  display: flex;
  padding: 20rpx;
  gap: 15rpx;
  background: white;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  padding: 18rpx 25rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 30rpx;
  font-size: 32rpx;
}

.search-btn {
  padding: 18rpx 40rpx;
  font-size: 32rpx;
}

.record-list {
  padding: 0 20rpx;
}

.record-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.patient-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.visit-date {
  font-size: 28rpx;
  color: #999;
}

.record-body {
  font-size: 30rpx;
}

.info-row {
  margin-bottom: 15rpx;
  display: flex;
}

.info-row.herbs {
  flex-direction: column;
}

.label {
  color: #666;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.value {
  color: #333;
  line-height: 1.6;
}

.info-row.herbs .value {
  margin-top: 10rpx;
  background: #f5f5f5;
  padding: 15rpx;
  border-radius: 8rpx;
  word-break: break-all;
}

.empty-state {
  text-align: center;
  padding: 150rpx 0;
  color: #999;
  font-size: 32rpx;
}

/* 详情弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 85%;
  max-height: 80vh;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  overflow-y: auto;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.detail-item {
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.detail-item.full {
  flex-direction: column;
}

.detail-label {
  color: #666;
  margin-right: 15rpx;
}

.herbs-text {
  display: block;
  margin-top: 10rpx;
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 8rpx;
  line-height: 1.8;
  word-break: break-all;
}

.copy-btn, .close-btn {
  width: 100%;
  margin-top: 20rpx;
  font-size: 32rpx;
}
