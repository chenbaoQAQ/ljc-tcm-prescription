/* pages/medical/create.wxss */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 30rpx 0 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.search-input {
  width: 300rpx;
  padding: 10rpx 20rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.picker-display {
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.prescription-list {
  max-height: 600rpx;
  overflow-y: scroll;
}

.prescription-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  background: white;
  margin-bottom: 15rpx;
  border-radius: 12rpx;
}

.prescription-name {
  margin-left: 20rpx;
  font-size: 32rpx;
  flex: 1;
}

.empty-hint {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

.preview-hint {
  text-align: center;
  padding: 30rpx;
  color: #666;
  font-size: 28rpx;
  background: #f9f9f9;
  margin: 30rpx 0;
  border-radius: 12rpx;
}

.save-btn {
  width: 100%;
  font-size: 36rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}

/* 成功弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 80%;
  max-width: 600rpx;
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #52c41a;
}

.result-section {
  margin-bottom: 25rpx;
}

.result-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.result-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
}

.result-text.herbs {
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 8rpx;
  word-break: break-all;
}

.copy-btn {
  margin-top: 15rpx;
  width: 100%;
}

.modal-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.modal-btn {
  flex: 1;
  font-size: 32rpx;
}

.modal-btn.primary {
  background: #1890ff;
  color: white;
}
