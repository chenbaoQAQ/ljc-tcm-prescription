/** app.wxss **/
page {
  background-color: #f5f5f5;
  font-size: 32rpx;
}

/* 大按钮样式 - 给妈妈用要大一点 */
.big-button {
  font-size: 36rpx;
  padding: 30rpx;
  margin: 20rpx;
}

/* 容器 */
.container {
  padding: 30rpx;
}

/* 卡片 */
.card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 表单项 */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 15rpx;
  display: block;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

/* 列表项 */
.list-item {
  background: white;
  padding: 30rpx;
  margin-bottom: 15rpx;
  border-radius: 12rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 30rpx;
}
